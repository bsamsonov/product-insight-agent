# Environment variables for the Product Insight Agent POC
# Copy this file to .env and fill in the values.
# Never commit the actual .env file.

# ── General ───────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Main app DB (used by poc.* packages)
POC_DB_URL=postgresql://postgres:postgres@localhost:5432/poc_db

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
POC_QDRANT_URL=http://localhost:6333
POC_QDRANT_API_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
POC_REDIS_URL=redis://localhost:6379/0

# ── Langfuse (self-hosted, see infra/langfuse/.env.example) ───────────────────
LANGFUSE_PORT=3000
# ClickHouse (used by Langfuse v3 for trace storage)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=langfuse
# MinIO (S3-compatible blob storage for Langfuse v3)
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=langfuse_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# After starting Langfuse, copy the project keys from infra/langfuse/.env
LANGFUSE_PUBLIC_KEY=lf-pub-changeme
LANGFUSE_SECRET_KEY=lf-sk-changeme
LANGFUSE_HOST=http://localhost:3000

# ── LLM providers ─────────────────────────────────────────────────────────────
# Primary: Google AI Studio (free tier — https://aistudio.google.com/apikey)
POC_GEMINI_API_KEY=
POC_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Fallback: Groq (free tier — https://console.groq.com)
POC_GROQ_API_KEY=
POC_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Escalate / reasoning: DeepSeek (pay-as-you-go, cheap)
POC_DEEPSEEK_API_KEY=
POC_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional: local Ollama
POC_OLLAMA_API_KEY=ollama
POC_OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: Anthropic (for benchmarks only)
POC_ANTHROPIC_API_KEY=

# Optional: any OpenAI-compatible gateway (LiteLLM, OpenRouter, OmniRoute, ...)
# proxying multiple upstream providers under a single endpoint.
POC_OMNIROUTE_API_KEY=
POC_OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Default provider used when none is passed explicitly (CLI --provider, API request
# body, etc). Falls back to "gemini" if unset — matches the quickstart above.
POC_DEFAULT_PROVIDER=gemini

# ── Multi-tenant ──────────────────────────────────────────────────────────────
# Default tenant for local dev
POC_DEFAULT_TENANT=dev-tenant
