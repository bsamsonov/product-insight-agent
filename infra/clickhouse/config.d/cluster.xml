<!-- Single-node "default" cluster definition for Langfuse v3 ON CLUSTER migrations -->
<clickhouse>
    <remote_servers>
        <default>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>

    <!-- Macros used in ReplicatedMergeTree table paths -->
    <macros>
        <shard>1</shard>
        <replica>clickhouse-1</replica>
        <cluster>default</cluster>
    </macros>
</clickhouse>
